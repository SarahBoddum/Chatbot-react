# Find databaseoplysninger i Supabase:
# Project Settings -> Database -> Connection string
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@[HOST]:5432/postgres

# Backend-serverens standardport
PORT=3000

GROQ_API_KEY=apiKey fra groq - hvis du ikke har den nu, så er du fucked, for den kan ikke vises igen (føler det tæller som 'helpful' :) - dne skal være hemmelig så alle ikke kan få fat i den og potnetielt bruge alle mine penge, hvis jeg var på en betalingsløsning